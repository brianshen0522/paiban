# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.

# ---- required -------------------------------------------------------------------------------
# Password of the application's database user. A long random string of letters and digits only:
# it is placed inside a connection URL, where characters such as @ : / would need escaping.
POSTGRES_PASSWORD=

# Encrypts the API keys an administrator enters on the sources page (TMDB, SubDL, assrt).
# 32 random bytes in base64:  openssl rand -base64 32
# Changing it later makes the stored keys unreadable; they then have to be entered again.
SECRET_KEY=

# The address people type in the browser. Used in invite and password-reset links.
PUBLIC_URL=http://localhost:8080

# First administrator, created only when the users table is empty. Change the password after
# the first sign-in; both lines can be removed afterwards.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- web ------------------------------------------------------------------------------------
# What Caddy serves. ":80" = plain HTTP on the port below (LAN, or behind another reverse proxy).
# A domain name here makes Caddy obtain a certificate itself; then also publish HTTPS_PORT.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- storage --------------------------------------------------------------------------------
# Where films, previews, subtitles and exports live on the host. Needs to be one filesystem.
DATA_PATH=./data
# Starting value of the capacity limit, in GB. Afterwards the limit is changed on the
# administrator's storage page; this variable is not read again.
STORAGE_LIMIT_GB=50
# Free space the application always leaves on the disk, in GB.
STORAGE_RESERVE_GB=2

# ---- BitTorrent -----------------------------------------------------------------------------
# Incoming connections. Forward both on the router: TORRENT_PORT for TCP and UDP,
# TORRENT_DHT_PORT for UDP. Without forwarding, downloads still work but are slower.
TORRENT_PORT=51413
TORRENT_DHT_PORT=51414

# ---- host -----------------------------------------------------------------------------------
# User and group that own DATA_PATH on the host (run `id` to see yours).
PUID=1000
PGID=1000
TZ=Asia/Taipei
# How much the three Node services write to stdout: debug, info, warn or error.
LOG_LEVEL=info

# ---- keys for the manual source checks ------------------------------------------------------
# Optional, and only for development. The scripts that check the real sources by hand in phase 0
# (item 4 of docs/14-plan.md) read these. The running site never does: its keys are entered on
# the administrator's sources page and stored encrypted.
TMDB_KEY=
ASSRT_TOKEN=
SUBDL_KEY=
