{"duration":92.373,"fps":23.976023976023978,"speechHz":100,"speechFrames":9242,"speech":[[300,498],[549,648],[782,876],[911,1040],[1086,1216],[1227,1309],[1391,1502],[1504,1636],[1890,2041],[2096,2169],[2206,2329],[2400,2617],[2729,2956],[3024,3204],[3515,3632],[3665,3797],[3941,4025],[4065,4085],[4087,4178],[4430,4448],[4752,4759],[4760,4776],[5062,5069],[5070,5083],[5474,5524],[5548,5670],[5732,5824],[5880,5927],[5953,6098],[6276,6395],[6445,6600],[6754,6815],[6896,7103],[7168,7260],[7465,7557],[7705,7813],[7868,7955],[7987,8055],[8147,8275],[8357,8493],[8504,8584],[8704,8843]],"peaksPerSec":50,"peaks":"","cues":[{"id":1,"start":2.95,"end":5.236,"zh":"你進來之後有把門鎖上嗎?","en":"Did you lock the door behind you?","who":"A"},{"id":2,"start":5.436,"end":6.774,"zh":"我以為是你鎖的。","en":"I thought you did.","who":"B"},{"id":3,"start":7.774,"end":10.708,"zh":"算了,我們只有十分鐘。","en":"Never mind. We have ten minutes.","who":"A"},{"id":4,"start":10.808,"end":13.353,"zh":"十分鐘要做什麼?","en":"Ten minutes for what, exactly?","who":"B"},{"id":5,"start":13.853,"end":16.648,"zh":"在他們回來之前找到那捲帶子。","en":"To find the tape before they come back.","who":"A"},{"id":6,"start":18.848,"end":20.714,"zh":"你說過它在辦公室裡。","en":"You said it was in the office.","who":"B"},{"id":7,"start":20.914,"end":23.539,"zh":"本來在,有人把它移走了。","en":"It was. Someone moved it.","who":"A"},{"id":8,"start":23.939,"end":26.444,"zh":"那你怎麼知道它還在這裡?","en":"Then how do you know it is still here?","who":"B"},{"id":9,"start":27.244,"end":29.879,"zh":"因為還沒有人離開這棟樓。","en":"Because nobody has left the building.","who":"A"},{"id":10,"start":30.179,"end":32.295,"zh":"這聽起來一點也不讓人放心。","en":"That is not very comforting.","who":"B"},{"id":11,"start":35.095,"end":38.259,"zh":"你去查櫃子,我來找書桌。","en":"Check the cabinet. I will take the desk.","who":"A"},{"id":12,"start":39.359,"end":40.497,"zh":"鎖住了。","en":"It is locked.","who":"B"},{"id":13,"start":40.597,"end":42.075,"zh":"想也知道。","en":"Of course it is.","who":"A"},{"id":14,"start":54.675,"end":56.971,"zh":"等等,我找到東西了。","en":"Wait. I found something.","who":"B"},{"id":15,"start":57.271,"end":58.549,"zh":"是那捲帶子嗎?","en":"Is it the tape?","who":"A"},{"id":16,"start":58.749,"end":61.304,"zh":"不是,是一張我們的合照。","en":"No. It is a photograph of us.","who":"B"},{"id":17,"start":62.704,"end":64.201,"zh":"不可能。","en":"That is impossible.","who":"A"},{"id":18,"start":64.401,"end":66.288,"zh":"你看背面的日期。","en":"Look at the date on the back.","who":"B"},{"id":19,"start":67.488,"end":68.407,"zh":"明天。","en":"Tomorrow.","who":"A"},{"id":20,"start":68.907,"end":71.332,"zh":"有人在耍我們。","en":"Somebody is playing a game with us.","who":"B"},{"id":21,"start":71.632,"end":72.9,"zh":"或者是在警告我們。","en":"Or warning us.","who":"A"},{"id":22,"start":77.0,"end":78.418,"zh":"你有聽到嗎?","en":"Did you hear that?","who":"B"},{"id":23,"start":78.618,"end":80.814,"zh":"是電梯,他們提早回來了。","en":"The elevator. They are early.","who":"A"},{"id":24,"start":81.414,"end":83.011,"zh":"現在怎麼辦?","en":"What do we do now?","who":"B"},{"id":25,"start":83.511,"end":86.096,"zh":"帶上照片,快跑。","en":"We take the photograph and we run.","who":"A"},{"id":26,"start":86.996,"end":88.723,"zh":"我就知道你會這麼說。","en":"I knew you would say that.","who":"B"}]}